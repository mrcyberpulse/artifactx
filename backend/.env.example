# Copy this file to backend/.env and fill in real values. Never commit the real .env file.

ARTIFACTX_ENVIRONMENT=development
ARTIFACTX_DOCS_ENABLED=true

# postgresql+psycopg://user:password@host:5432/dbname
ARTIFACTX_DATABASE_URL=postgresql+psycopg://artifactx:artifactx@localhost:5432/artifactx
ARTIFACTX_REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ARTIFACTX_SECRET_KEY=replace-with-a-generated-random-secret-at-least-32-characters-long

ARTIFACTX_ACCESS_TOKEN_MINUTES=15
ARTIFACTX_REFRESH_TOKEN_DAYS=14
ARTIFACTX_PASSWORD_RESET_MINUTES=30

# Set to false only for local HTTP development. Must be true in production (HTTPS).
ARTIFACTX_COOKIE_SECURE=false

ARTIFACTX_REGISTRATION_ENABLED=true
ARTIFACTX_RATE_LIMIT_ENABLED=true

# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
ARTIFACTX_CORS_ORIGINS=http://localhost:5173
ARTIFACTX_FRONTEND_URL=http://localhost:5173
